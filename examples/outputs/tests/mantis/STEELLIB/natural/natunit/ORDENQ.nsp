IF #PRICECALC-CALLED
  AND #PRICECALC-ORDER-NO = #ORDER-NO
  AND #PRICECALC-ORDER-WT = #ORDER-WT
  MOVE "TRUE" TO #ACTUAL
ELSE
  MOVE "FALSE" TO #ACTUAL
END-IF
CALLNAT 'ASSERT-EQUAL' #EXPECTED #ACTUAL 'test_ordenq_case_conf_calls_pricecalc'
