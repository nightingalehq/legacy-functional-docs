* ORDENQ - ORDER ENQUIRY (MANTIS/SUPRA)
PROGRAM "ORDENQ"
TEXT ORDER_NO(10)
TEXT CUST_NO(8)
NUMERIC ORDER_WT(9.3)
TEXT MSG(60)
VIEW ORDVIEW OF ORDERMST
EXTERNAL "STEELLIB","PRICECALC"
ENTRY MAIN
  CONVERSE ORDSCR1
  IF ORDER_NO = " "
    MSG = "Order number required"
    SHOW ORDSCR1
  END
  READM(ORDERMST, ORDER_NO)
  IF STATUS <> 0
    MSG = "Order not found"
    SHOW ORDSCR1
  END
  OBTAIN ORDVIEW WHERE ORDER_NO = ORDER_NO
  WHILE STATUS = 0
    ORDER_WT = ORDER_WT + ORDVIEW.LINE_WT
    RDNXT(ORDLINE, ORDER_NO)
  END
  CASE ORDVIEW.STATUS
    WHEN "CONF"
      CALL "PRICECALC" (ORDER_NO, ORDER_WT)
    WHEN "HELD"
      MSG = "Order is on credit hold"
  END
  WRITM(ORDERMST, ORDER_NO)
  ENDTR
  CONVERSE ORDSCR2
EXIT

ENTRY VALIDATE_CREDIT_LIMIT
  IF ORDER_WT > 500
    'OR CUST_NO = " "
    MSG = "Credit check required"
    SHOW ORDSCR1
  END
EXIT
