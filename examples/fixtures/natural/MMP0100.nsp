**********************************************************************
** MMP0100 - MILL ORDER RELEASE TO PRODUCTION                       **
** AUTHOR : J.PRICE      DATE: 14/03/1994                           **
** AMENDED: 22/11/2003 - ADD GRADE SUBSTITUTION CHECK (CR 4471)     **
**********************************************************************
DEFINE DATA
LOCAL USING MMLDA01
PARAMETER
1 #ORDER-NO          (A10)
1 #PLANT             (A4)
1 #RETURN-CODE       (N2)
LOCAL
1 ORDER-VIEW VIEW OF MILL-ORDER
  2 ORDER-NO
  2 CUSTOMER-NO
  2 GRADE-CODE
  2 ORDER-STATUS
  2 ORDER-WEIGHT
  2 DUE-DATE
1 STOCK-VIEW VIEW OF STOCK-BALANCE
  2 GRADE-CODE
  2 PLANT-CODE
  2 AVAIL-WEIGHT
1 AUDIT-VIEW VIEW OF ORDER-AUDIT
  2 ORDER-NO
  2 AUDIT-TS
1 #AVAIL-TOTAL       (P9.3) INIT <0>
1 #TOLERANCE-PCT     (N3.2) INIT <2.50>
END-DEFINE
*
RESET #RETURN-CODE
*
FIND ORDER-VIEW WITH ORDER-NO = #ORDER-NO
  IF NO RECORDS FOUND
    MOVE 10 TO #RETURN-CODE
    ESCAPE ROUTINE
  END-NOREC
  IF ORDER-VIEW.ORDER-STATUS NE 'CONF'
    MOVE 20 TO #RETURN-CODE
    ESCAPE ROUTINE
  END-IF
*
  READ STOCK-VIEW BY GRADE-CODE STARTING FROM ORDER-VIEW.GRADE-CODE
    IF STOCK-VIEW.GRADE-CODE NE ORDER-VIEW.GRADE-CODE
      ESCAPE BOTTOM
    END-IF
    IF STOCK-VIEW.PLANT-CODE = #PLANT
      ADD STOCK-VIEW.AVAIL-WEIGHT TO #AVAIL-TOTAL
    END-IF
  END-READ
*
  DECIDE FOR FIRST CONDITION
    WHEN #AVAIL-TOTAL >= ORDER-VIEW.ORDER-WEIGHT
      MOVE 'RLSD' TO ORDER-VIEW.ORDER-STATUS
    WHEN #AVAIL-TOTAL >= ORDER-VIEW.ORDER-WEIGHT * (1 - #TOLERANCE-PCT / 100)
      MOVE 'PART' TO ORDER-VIEW.ORDER-STATUS
      CALLNAT 'MMN0250' #ORDER-NO #AVAIL-TOTAL #RETURN-CODE
    WHEN NONE
      MOVE 30 TO #RETURN-CODE
      ESCAPE ROUTINE
  END-DECIDE
*
  UPDATE ORDER-VIEW
  END TRANSACTION #ORDER-NO
END-FIND
*
CALLNAT 'MMN0900' #ORDER-NO #PLANT
PERFORM WRITE-AUDIT
*
DEFINE SUBROUTINE WRITE-AUDIT
  STORE AUDIT-VIEW
  END TRANSACTION
END-SUBROUTINE
*
END
